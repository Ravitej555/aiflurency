# ThreatLens AI — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle.
# All other variables are server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (used by Axios client)
# In Docker Compose, use the internal service name: http://backend:8000
# In production (ECS), use the ALB internal DNS or API domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application name (optional override)
NEXT_PUBLIC_APP_NAME=ThreatLens AI
