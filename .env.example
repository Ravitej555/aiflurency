# ─────────────────────────────────────────────────────────────────────────────
# ThreatLens AI — Environment Variables Template
# Copy to .env in project root for Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Configuration
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens_user
POSTGRES_PASSWORD=SuperSecretPassword123!

# FastAPI Security & Keys
SECRET_KEY=your-super-secret-jwt-key-change-in-production
GEMINI_API_KEY=your_gemini_api_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS / Registry settings (for production deployments)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
