# ThreatLens AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env files to version control.
# In production, inject these via AWS Secrets Manager or ECS Task env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Database ─────────────────────────────────────────────────────────────────
# In Docker Compose, use the service name as the host: postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── JWT Security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ECR_REGISTRY=YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
